# ==============================================================================
# GPAL ("Google Pal") — Environment Configuration Template
# Copy this file to .env or generate it automatically from Terraform outputs:
#   terraform -chdir=terraform output -raw dotenv_configuration > .env
# ==============================================================================

# --- Google Cloud & Vertex AI Settings ---
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GPAL_ENVIRONMENT=dev

# --- Optional: Gemini Developer API Key (Only if GOOGLE_GENAI_USE_VERTEXAI=FALSE) ---
# Prefer storing keys in Google Cloud Secret Manager via SECRET_MANAGER_SECRET_ID
GOOGLE_API_KEY=

# --- Secret Manager Integration ---
SECRET_MANAGER_SECRET_ID=gpal-api-key-dev

# --- Google Cloud Model Armor & Sensitive Data Protection (PII Scrubbing) ---
# Full resource name provisioned by Terraform:
# projects/<PROJECT_ID>/locations/<LOCATION>/templates/gpal-safety-armor-dev
MODEL_ARMOR_TEMPLATE_ID=
ENABLE_CLOUD_DLP=FALSE
DLP_INSPECT_TEMPLATE_NAME=
DLP_DEIDENTIFY_TEMPLATE_NAME=

# --- Observability & Distributed Tracing ---
ENABLE_CLOUD_TRACE=TRUE
LOG_LEVEL=INFO

# --- Session Persistence & Context Compaction ---
USE_VERTEX_SESSION_SERVICE=FALSE
SESSION_DB_URL=sqlite+aiosqlite:///./gpal_sessions.db
COMPACTION_TOKEN_THRESHOLD=5000
EVENT_RETENTION_SIZE=5

# --- Voice & Gemini TTS Model Configuration ---
DEFAULT_GEMINI_VOICE=Puck
GEMINI_FAST_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro
GEMINI_TTS_PRIMARY_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_EXPRESSIVE_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_FALLBACK_MODEL=gemini-2.5-flash-preview-tts
GEMINI_LIVE_VOICE_MODEL=gemini-live-2.5-flash-native-audio
AUTO_SYNTHESIZE_VOICE_REPLY=TRUE

# --- Vertex AI Agent Engine Deployment ---
STAGING_BUCKET_URI=

