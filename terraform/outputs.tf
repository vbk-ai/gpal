output "project_id" {
  description = "Google Cloud Project ID where GPAL resources are deployed."
  value       = var.project_id
}

output "region" {
  description = "Primary Google Cloud region for Vertex AI and storage resources."
  value       = var.region
}

output "environment" {
  description = "Active deployment environment tier (dev, staging, or prod)."
  value       = var.environment
}

output "service_account_email" {
  description = "Email address of the least-privilege GPAL runtime service account."
  value       = var.manage_iam ? google_service_account.gpal_runtime_sa[0].email : local.runtime_sa_email
}

output "model_armor_template_id" {
  description = "Full resource ID of the provisioned Google Cloud Model Armor safety template."
  value       = google_model_armor_template.gpal_safety_armor.id
}

output "dlp_inspect_template_name" {
  description = "Full resource name of the Cloud DLP inspect template for PII detection."
  value       = google_data_loss_prevention_inspect_template.gpal_pii_inspect.id
}

output "dlp_deidentify_template_name" {
  description = "Full resource name of the Cloud DLP de-identification template for PII redaction."
  value       = google_data_loss_prevention_deidentify_template.gpal_pii_deidentify.id
}

output "staging_bucket_uri" {
  description = "Cloud Storage URI (`gs://...`) used for Vertex AI Agent Engine deployment staging."
  value       = "gs://${google_storage_bucket.gpal_staging_bucket.name}"
}

output "secret_manager_secret_id" {
  description = "Secret Manager secret identifier for storing external API credentials."
  value       = google_secret_manager_secret.gpal_api_secret.secret_id
}

output "artifact_registry_repository" {
  description = "Artifact Registry Docker repository path for GPAL container images."
  value       = "${var.region}-docker.pkg.dev/${var.project_id}/${google_artifact_registry_repository.gpal_repo.repository_id}"
}

output "dotenv_configuration" {
  description = "Ready-to-use .env content generated from provisioned Terraform resources (`terraform -chdir=terraform output -raw dotenv_configuration > .env`)."
  value       = <<-EOT
    # Generated by Terraform for environment: ${var.environment}
    GOOGLE_GENAI_USE_VERTEXAI=TRUE
    GOOGLE_CLOUD_PROJECT=${var.project_id}
    GOOGLE_CLOUD_LOCATION=${var.region}
    GPAL_ENVIRONMENT=${var.environment}
    SECRET_MANAGER_SECRET_ID=${google_secret_manager_secret.gpal_api_secret.secret_id}
    MODEL_ARMOR_TEMPLATE_ID=${google_model_armor_template.gpal_safety_armor.id}
    ENABLE_CLOUD_DLP=TRUE
    DLP_INSPECT_TEMPLATE_NAME=${google_data_loss_prevention_inspect_template.gpal_pii_inspect.id}
    DLP_DEIDENTIFY_TEMPLATE_NAME=${google_data_loss_prevention_deidentify_template.gpal_pii_deidentify.id}
    ENABLE_CLOUD_TRACE=TRUE
    LOG_LEVEL=INFO
    USE_VERTEX_SESSION_SERVICE=FALSE
    SESSION_DB_URL=sqlite+aiosqlite:///./gpal_sessions.db
    COMPACTION_TOKEN_THRESHOLD=5000
    EVENT_RETENTION_SIZE=5
    DEFAULT_GEMINI_VOICE=Puck
    GEMINI_FAST_MODEL=gemini-2.5-flash
    GEMINI_PRO_MODEL=gemini-2.5-pro
    GEMINI_TTS_PRIMARY_MODEL=gemini-3.8-flash-lite-tts
    GEMINI_TTS_EXPRESSIVE_MODEL=gemini-3.8-flash-tts
    GEMINI_TTS_FALLBACK_MODEL=gemini-2.5-flash-preview-tts
    GEMINI_LIVE_VOICE_MODEL=gemini-live-2.5-flash-native-audio
    AUTO_SYNTHESIZE_VOICE_REPLY=TRUE
    STAGING_BUCKET_URI=gs://${google_storage_bucket.gpal_staging_bucket.name}
  EOT
}
